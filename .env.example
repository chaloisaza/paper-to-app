ANTHROPIC_API_KEY=
# Optional
# PAPER_MODEL=claude-fable-5-1     # model that reads the sketch (default)
# FAST_MODE=1                      # only honoured when PAPER_MODEL is claude-opus-5 / claude-opus-4-8
# REFUSAL_FALLBACK=0               # turn off server-side refusal fallback (on by default)
# RECORD=1                         # save every run to recordings/<name>.json for offline replay
# BUDGET_USD=5                     # hard spend cap; past it the server replays instead of calling the API ("off" = no cap)
# PORT=8787
